# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# Start the stack from the repo root with:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d

# --- ClickHouse (traces) ---
CLICKHOUSE_DB=vigil
CLICKHOUSE_USER=vigil
CLICKHOUSE_PASSWORD=change_me_clickhouse

# --- Postgres (metadata, eval results) ---
POSTGRES_DB=vigil
POSTGRES_USER=vigil
POSTGRES_PASSWORD=change_me_postgres

# --- Read-only roles for the dashboard API (created by deploy/create_readonly_users.sh) ---
POSTGRES_RO_USER=vigil_ro
POSTGRES_RO_PASSWORD=change_me_postgres_ro
CLICKHOUSE_RO_USER=vigil_ro
CLICKHOUSE_RO_PASSWORD=change_me_clickhouse_ro

# --- Redis (cache, job queue) ---
REDIS_PASSWORD=change_me_redis

# --- LLM providers (used by engine/, leave blank until needed) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Ingest service (ingest/) ---
# Defaults target the local Docker stack; override only if you change ports/hosts.
# Endpoints reached from host processes use the external listeners.
VIGIL_LOG_LEVEL=info

# Redpanda (Kafka API, external listener on the host).
VIGIL_KAFKA_BROKERS=127.0.0.1:19092
VIGIL_RAW_TOPIC=otlp.spans.raw
VIGIL_DLQ_TOPIC=spans.dlq
# Total disk budget (bytes) for otlp.spans.raw across all partitions; the topic creator
# divides it by the partition count for Kafka's per-partition retention.bytes. ~4 GiB.
VIGIL_RAW_RETENTION_BYTES=4294967296

# ClickHouse native protocol (auth reuses the CLICKHOUSE_* vars above).
VIGIL_CLICKHOUSE_ADDR=127.0.0.1:9000

# Receiver listeners (bind loopback by default, like the rest of the stack).
VIGIL_OTLP_GRPC_ADDR=127.0.0.1:4317
VIGIL_OTLP_HTTP_ADDR=127.0.0.1:4318
VIGIL_HEALTH_ADDR=127.0.0.1:8088
VIGIL_MAX_REQUEST_BYTES=4194304

# Writer batching + consumer group.
VIGIL_KAFKA_GROUP=vigil-writer
VIGIL_BATCH_MAX_ROWS=10000
VIGIL_BATCH_MAX_BYTES=33554432
VIGIL_FLUSH_INTERVAL=2s
