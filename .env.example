# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# Start the stack from the repo root with:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d

# --- ClickHouse (traces) ---
CLICKHOUSE_DB=vigil
CLICKHOUSE_USER=vigil
CLICKHOUSE_PASSWORD=change_me_clickhouse

# --- Postgres (metadata, eval results) ---
POSTGRES_DB=vigil
POSTGRES_USER=vigil
POSTGRES_PASSWORD=change_me_postgres

# --- Redis (cache, job queue) ---
REDIS_PASSWORD=change_me_redis

# --- LLM providers (used by engine/, leave blank until needed) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
